<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ashare.daily-update</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/yexiyan/.cache/codex-runtimes/codex-primary-runtime/dependencies/python/bin/python3</string>
        <string>/Users/yexiyan/Documents/A股复盘/daily_update.py</string>
        <string>--proxy</string>
        <string>socks5h://127.0.0.1:7897</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>18</integer>
        <key>Minute</key>
        <integer>5</integer>
    </dict>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin:/opt/homebrew/bin</string>
        <key>HOME</key>
        <string>/Users/yexiyan</string>
        <key>LANG</key>
        <string>zh_CN.UTF-8</string>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/tmp/stock_daily_update.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/stock_daily_update.log</string>
</dict>
</plist>
