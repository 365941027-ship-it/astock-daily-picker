<view class="card">
  <view class="card-title">预判核对</view>
  <view class="form-row">
    <text class="label">核对日</text>
    <picker mode="date" value="{{date}}" bindchange="onDateChange">
      <view class="picker-value">{{date || "请选择日期"}}</view>
    </picker>
  </view>
  <view class="hint">回看“核对日前一交易日”候选的实际表现，自动判定兑现/失效并修正后续观察。</view>
  <view class="actions">
    <button class="btn-primary" bindtap="loadVerify">核对</button>
  </view>
</view>

<view class="card summary-card" wx:if="{{summary}}">
  <view class="card-title">核对结果</view>
  <view class="summary-text">
    观察日 <text class="strong">{{summary.date}}</text> 的候选，在
    <text class="strong">{{summary.checked_on}}</text> 的核对：
    共 {{summary.total}} 条，兑现 <text class="ok">{{summary.valid}}</text> 条，
    失效 <text class="bad">{{summary.failed}}</text> 条。
  </view>
</view>

<view class="section-head" wx:if="{{entries.length}}">
  <text>逐条核对</text>
  <text class="count-badge">{{entries.length}}</text>
</view>
<scroll-view class="table-wrap scroll-x" scroll-x wx:if="{{entries.length}}">
  <view class="tbl">
    <view class="tr th">
      <view class="td w-code">代码</view><view class="td w-name">名称</view>
      <view class="td w-num">观察收盘</view><view class="td w-num">支撑位</view>
      <view class="td w-num">次日收盘</view><view class="td w-num">次日涨跌</view>
      <view class="td w-judge">判定</view><view class="td w-sugg">修正建议</view>
    </view>
    <view wx:for="{{entries}}" wx:key="code" class="tr">
      <view class="td w-code">{{item.code}}</view>
      <view class="td w-name">{{item.name}}</view>
      <view class="td w-num">{{item.prev_close}}</view>
      <view class="td w-num">{{item.support}}</view>
      <view class="td w-num">{{item.next_close}}</view>
      <view class="td w-num {{item.next_pct > 0 ? 'up' : item.next_pct < 0 ? 'down' : ''}}">{{item.next_pct_text}}</view>
      <view class="td w-judge verdict {{item.verdict_class}}">{{item.detail}}</view>
      <view class="td w-sugg">{{item.suggestion}}</view>
    </view>
  </view>
</scroll-view>
<view class="empty" wx:if="{{!entries.length && loaded}}">当天没有候选可核对。</view>

<view class="footer-note">失效（跌破支撑/大跌）的候选将从后续观察中剔除；兑现的继续跟踪。</view>
