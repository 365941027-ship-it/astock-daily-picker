/* ---------- 策略总览 ---------- */
.hero {
  margin: 20rpx 24rpx 4rpx;
  border-radius: 32rpx;
  padding: 36rpx 32rpx;
  background: linear-gradient(135deg, #16324f 0%, #1e3a8a 100%);
  color: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(22, 50, 79, 0.35);
}
.hero-title { font-size: 34rpx; font-weight: 700; }
.hero-sub { font-size: 24rpx; opacity: 0.75; margin-top: 6rpx; }
.hero-nums {
  display: flex;
  gap: 12rpx;
  margin-top: 26rpx;
}
.hn-item {
  flex: 1;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 16rpx;
  padding: 16rpx 0;
  text-align: center;
}
.hn-v { display: block; font-size: 34rpx; font-weight: 700; }
.hn-k { display: block; font-size: 22rpx; opacity: 0.85; margin-top: 2rpx; }
.ok { color: #69db7c; }
.bad { color: #ff8a8a; }

/* ---------- 参数 ---------- */
.form-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #f1f3f7;
}
.label { width: 160rpx; color: #6b7684; font-size: 28rpx; }
.picker-value {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  padding: 10rpx 0;
}
.arrow { color: #b6bfcc; font-size: 34rpx; }
.hint { color: #9aa4b2; font-size: 24rpx; margin-top: 16rpx; }
.actions { margin-top: 24rpx; }

/* ---------- 当日摘要 ---------- */
.summary-card { background: #f8fbff; }
.summary-line { font-size: 28rpx; color: #3d4754; }
.strong { font-weight: 700; color: #16233b; }
.arrow-g { color: #b6bfcc; margin: 0 8rpx; }
.summary-stats {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
}
.ss-item {
  flex: 1;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 16rpx 0;
  text-align: center;
  box-shadow: 0 2rpx 10rpx rgba(26, 45, 90, 0.05);
}
.ss-v { display: block; font-size: 34rpx; font-weight: 700; }
.ss-k { display: block; font-size: 22rpx; color: #6b7684; margin-top: 2rpx; }

/* ---------- 核对卡片 ---------- */
.verify-card {
  background: #ffffff;
  border-radius: 24rpx;
  margin: 0 24rpx 16rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(26, 45, 90, 0.06);
}
.vc-top { display: flex; justify-content: space-between; align-items: center; }
.vc-name { font-size: 30rpx; font-weight: 700; }
.vc-code { color: #9aa4b2; font-size: 22rpx; font-weight: 400; margin-left: 10rpx; }
.vc-pct { font-size: 32rpx; font-weight: 700; }
.vc-row {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  font-size: 25rpx;
}
.vc-k { color: #9aa4b2; }
.vc-v { color: #16233b; font-weight: 600; margin-left: 8rpx; }
.vc-sep { margin-left: 24rpx; }
.vc-judge { margin-top: 16rpx; }
.badge {
  display: inline-block;
  font-size: 23rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-weight: 600;
}
.verdict-valid { background: #e6f9ec; color: #2f9e44; }
.verdict-failed { background: #ffe9e9; color: #e03131; }
.verdict-strong { background: #e7f1ff; color: #2563eb; }
.verdict-weak, .verdict-neutral { background: #f1f3f7; color: #6b7684; }
.vc-sugg {
  margin-top: 12rpx;
  color: #5b6b82;
  font-size: 24rpx;
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
}
