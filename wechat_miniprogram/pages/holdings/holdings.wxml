<view class="hero" wx:if="{{summary}}">
  <view class="hero-title">模拟账户总览</view>
  <view class="hero-sub">模拟盘 · 不构成任何投资建议</view>
  <view class="hero-nums">
    <view class="hn-item">
      <text class="hn-v">{{summary.total_value_text}}</text>
      <text class="hn-k">总资产</text>
    </view>
    <view class="hn-item">
      <text class="hn-v {{summary.pnl >= 0 ? 'ok' : 'bad'}}">{{summary.pnl_text}}</text>
      <text class="hn-k">总盈亏</text>
    </view>
    <view class="hn-item">
      <text class="hn-v">{{summary.cash_text}}</text>
      <text class="hn-k">可用资金</text>
    </view>
  </view>
</view>

<view class="card">
  <view class="card-title">记一笔交易</view>
  <view class="form-row">
    <text class="label">代码</text>
    <input class="input" value="{{trade.code}}" bindinput="onTradeCode" placeholder="如 600126" placeholder-class="ph" />
  </view>
  <view class="form-row">
    <text class="label">名称</text>
    <input class="input" value="{{trade.name}}" bindinput="onTradeName" placeholder="如 杭钢股份" placeholder-class="ph" />
  </view>
  <view class="form-row">
    <text class="label">价格</text>
    <input class="input" type="digit" value="{{trade.price}}" bindinput="onTradePrice" placeholder="成交价" placeholder-class="ph" />
  </view>
  <view class="form-row">
    <text class="label">数量(股)</text>
    <input class="input" type="number" value="{{trade.shares}}" bindinput="onTradeShares" placeholder="股数" placeholder-class="ph" />
  </view>
  <view class="form-row">
    <text class="label">操作</text>
    <view class="seg">
      <view class="seg-item {{trade.action === 'buy' ? 'on-buy' : ''}}" bindtap="setAction" data-action="buy">买入</view>
      <view class="seg-item {{trade.action === 'sell' ? 'on-sell' : ''}}" bindtap="setAction" data-action="sell">卖出</view>
    </view>
  </view>
  <view class="actions">
    <button class="btn-primary" bindtap="submitTrade">确认交易</button>
  </view>
</view>

<view class="section-head" wx:if="{{positions.length}}">
  <text>当前持仓</text>
  <text class="count-badge">{{positions.length}}</text>
</view>
<view class="pos-card" wx:for="{{positions}}" wx:key="code"
      bindtap="openDetail" data-code="{{item.code}}" data-date="{{defaultDate}}" data-name="{{item.name}}">
  <view class="pc-top">
    <view class="pc-name">{{item.name}}<text class="pc-code">{{item.code}}</text></view>
    <view class="pc-pnl {{item.pnl >= 0 ? 'up' : 'down'}}">{{item.pnl_text}}</view>
  </view>
  <view class="pc-grid">
    <view class="pc-cell"><text class="pc-k">现价</text><text class="pc-v">{{item.close_text}}</text></view>
    <view class="pc-cell"><text class="pc-k">成本</text><text class="pc-v">{{item.cost}}</text></view>
    <view class="pc-cell"><text class="pc-k">数量</text><text class="pc-v">{{item.shares}}</text></view>
    <view class="pc-cell"><text class="pc-k">市值</text><text class="pc-v">{{item.market_value_text}}</text></view>
    <view class="pc-cell"><text class="pc-k">盈亏率</text><text class="pc-v {{item.pnl >= 0 ? 'up' : 'down'}}">{{item.pnl_rate_text}}</text></view>
    <view class="pc-cell"><text class="pc-k">入场日</text><text class="pc-v">{{item.added_at}}</text></view>
  </view>
  <view class="pc-actions">
    <view class="pc-btn" catchtap="openSell" data-code="{{item.code}}" data-name="{{item.name}}" data-shares="{{item.shares}}" data-price="{{item.close}}">卖出</view>
    <view class="pc-btn danger" catchtap="closePos" data-code="{{item.code}}">平仓</view>
  </view>
</view>
<view class="empty" wx:if="{{!positions.length}}">暂无持仓，先记一笔买入。</view>

<view class="section-head" wx:if="{{trades.length}}">
  <text>交易记录</text>
  <text class="count-badge">{{trades.length}}</text>
</view>
<view class="card trade-card" wx:if="{{trades.length}}">
  <view wx:for="{{trades}}" wx:key="uid" class="trade-item">
    <view class="tr-top">
      <text class="tr-action {{item.action === 'buy' ? 'buy' : 'sell'}}">{{item.action === 'buy' ? '买' : '卖'}}</text>
      <text class="tr-name">{{item.name}}</text>
      <text class="tr-code">{{item.code}}</text>
      <text class="tr-date">{{item.date}}</text>
    </view>
    <view class="tr-detail">
      {{item.shares}} 股 @ {{item.price}}　金额 {{item.amount_text}}
    </view>
  </view>
</view>

<view class="footer-note">模拟持仓用于复盘“观察→买入→卖出”的完整过程，不涉及真实资金。</view>
