.hero {
  margin: 20rpx 24rpx 4rpx;
  border-radius: 32rpx;
  padding: 36rpx 32rpx;
  background: linear-gradient(135deg, #143c2b 0%, #1e6b47 100%);
  color: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(20, 60, 43, 0.35);
}
.hero-title { font-size: 34rpx; font-weight: 700; }
.hero-sub { font-size: 24rpx; opacity: 0.75; margin-top: 6rpx; }
.hero-nums { display: flex; gap: 12rpx; margin-top: 26rpx; }
.hn-item {
  flex: 1;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 16rpx;
  padding: 16rpx 0;
  text-align: center;
}
.hn-v { display: block; font-size: 32rpx; font-weight: 700; }
.hn-k { display: block; font-size: 22rpx; opacity: 0.85; margin-top: 2rpx; }
.ok { color: #8ce99a; }
.bad { color: #ffa8a8; }

.form-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #f1f3f7;
}
.form-row:last-of-type { border-bottom: none; }
.label { width: 160rpx; color: #6b7684; font-size: 28rpx; }
.input { flex: 1; font-size: 28rpx; }
.ph { color: #b6bfcc; }
.seg { flex: 1; display: flex; gap: 16rpx; }
.seg-item {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 14rpx;
  border: 2rpx solid #e4e8ee;
  color: #6b7684;
  font-size: 26rpx;
}
.seg-item.on-buy { background: #e7f1ff; border-color: #2563eb; color: #2563eb; font-weight: 600; }
.seg-item.on-sell { background: #ffe9e9; border-color: #e03131; color: #e03131; font-weight: 600; }
.actions { margin-top: 24rpx; }

.pos-card {
  background: #ffffff;
  border-radius: 24rpx;
  margin: 0 24rpx 16rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(26, 45, 90, 0.06);
  border-left: 8rpx solid #1e6b47;
}
.pc-top { display: flex; justify-content: space-between; align-items: center; }
.pc-name { font-size: 30rpx; font-weight: 700; }
.pc-code { color: #9aa4b2; font-size: 22rpx; font-weight: 400; margin-left: 10rpx; }
.pc-pnl { font-size: 32rpx; font-weight: 700; }
.pc-grid { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 18rpx; }
.pc-cell {
  width: calc(33.33% - 8rpx);
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 12rpx;
}
.pc-k { display: block; font-size: 20rpx; color: #8a93a3; }
.pc-v { display: block; font-size: 27rpx; font-weight: 700; margin-top: 4rpx; }
.pc-actions { display: flex; gap: 16rpx; margin-top: 18rpx; }
.pc-btn {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 14rpx;
  border: 2rpx solid #2563eb;
  color: #2563eb;
  font-size: 26rpx;
  font-weight: 600;
}
.pc-btn.danger { border-color: #e03131; color: #e03131; }

.trade-card { padding: 12rpx 28rpx; }
.trade-item {
  padding: 18rpx 0;
  border-bottom: 2rpx solid #f1f3f7;
}
.trade-item:last-child { border-bottom: none; }
.tr-top { display: flex; align-items: center; }
.tr-action {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  margin-right: 12rpx;
  font-weight: 600;
}
.tr-action.buy { background: #e7f1ff; color: #2563eb; }
.tr-action.sell { background: #ffe9e9; color: #e03131; }
.tr-name { font-weight: 600; font-size: 27rpx; }
.tr-code { color: #9aa4b2; font-size: 22rpx; margin-left: 10rpx; }
.tr-date { margin-left: auto; color: #9aa4b2; font-size: 22rpx; }
.tr-detail { margin-top: 8rpx; color: #6b7684; font-size: 24rpx; }

.footer-note {
  text-align: center;
  color: #9aa4b2;
  font-size: 22rpx;
  padding: 36rpx 0 60rpx;
}
