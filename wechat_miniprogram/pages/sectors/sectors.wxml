<view class="card">
  <view class="card-title">行业板块热度</view>
  <view class="hint">按当日涨跌幅排序，前 30 个行业板块（数据来自东方财富）</view>
  <view class="actions">
    <button class="btn-primary" bindtap="loadSectors">刷新</button>
  </view>
</view>

<view class="sector-card" wx:for="{{list}}" wx:key="code">
  <view class="sc-rank">{{index + 1}}</view>
  <view class="sc-main">
    <view class="sc-name">{{item.name}}</view>
    <view class="sc-leader" wx:if="{{item.leader}}">龙头：{{item.leader}}</view>
  </view>
  <view class="sc-pct {{item.pct_chg > 0 ? 'up' : item.pct_chg < 0 ? 'down' : ''}}">{{item.pct_text}}</view>
</view>
<view class="empty" wx:if="{{!list.length && loaded}}">暂无板块数据，请确认网络后重试。</view>

<view class="footer-note">板块强弱用于辅助判断候选股的“板块同步”条件。</view>
