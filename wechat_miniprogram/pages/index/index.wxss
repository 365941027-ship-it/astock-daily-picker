/* ---------- 市场概览 ---------- */
.hero {
  margin: 20rpx 24rpx 4rpx;
  border-radius: 32rpx;
  padding: 36rpx 32rpx;
  background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 60%, #3b82f6 100%);
  color: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(30, 58, 138, 0.35);
}
.hero-title { font-size: 34rpx; font-weight: 700; }
.hero-sub { font-size: 24rpx; opacity: 0.8; margin-top: 6rpx; }
.hero-indices {
  display: flex;
  gap: 12rpx;
  margin: 26rpx 0 4rpx;
}
.hero-index {
  flex: 1;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 16rpx;
  padding: 16rpx;
  text-align: center;
}
.hi-name { display: block; font-size: 22rpx; opacity: 0.85; }
.hi-close { display: block; font-size: 30rpx; font-weight: 700; margin: 6rpx 0; }
.hi-pct { font-size: 24rpx; font-weight: 600; }
.hero-stats {
  display: flex;
  gap: 10rpx;
  margin-top: 16rpx;
}
.hs-item {
  flex: 1;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 16rpx;
  padding: 14rpx 0;
  text-align: center;
}
.hs-v { display: block; font-size: 32rpx; font-weight: 700; }
.hs-k { display: block; font-size: 22rpx; opacity: 0.85; margin-top: 2rpx; }

/* ---------- 参数表单 ---------- */
.form-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #f1f3f7;
}
.form-row:last-of-type {
  border-bottom: none;
}
.label {
  width: 180rpx;
  color: #6b7684;
  font-size: 28rpx;
}
.input {
  flex: 1;
  font-size: 28rpx;
}
.ph { color: #b6bfcc; }
.picker-value {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  color: #16233b;
  padding: 10rpx 0;
}
.arrow { color: #b6bfcc; font-size: 34rpx; }
.actions { margin-top: 26rpx; }
.quick-links {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}
.ql-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 16rpx;
  background: #f8fafc;
  border: 2rpx solid #eef1f5;
  color: #2563eb;
  font-size: 26rpx;
  font-weight: 600;
}

/* ---------- 日志 ---------- */
.log-card { padding: 28rpx; }
.log-box {
  max-height: 300rpx;
  background: #0f172a;
  color: #cbd5e1;
  border-radius: 18rpx;
  padding: 18rpx;
  font-size: 24rpx;
  font-family: ui-monospace, Menlo, monospace;
}
.log-line { padding: 4rpx 0; }

/* ---------- 候选卡片 ---------- */
.stock-card {
  position: relative;
  background: #ffffff;
  border-radius: 24rpx;
  margin: 0 24rpx 16rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(26, 45, 90, 0.06);
  border-left: 8rpx solid #2563eb;
}
.stock-card.strong {
  border-left-color: #f59f00;
}
.sc-left { display: inline-block; max-width: 65%; }
.sc-name { font-size: 30rpx; font-weight: 700; }
.sc-code { color: #9aa4b2; font-size: 22rpx; font-weight: 400; margin-left: 10rpx; }
.sc-tags { margin-top: 10rpx; }
.tag {
  display: inline-block;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  margin-right: 10rpx;
}
.tag-blue { background: #e7f1ff; color: #2563eb; }
.tag-gray { background: #f1f3f7; color: #6b7684; }
.tag-orange { background: #fff3e0; color: #e8590c; }
.sc-right {
  float: right;
  text-align: right;
}
.sc-price { font-size: 34rpx; font-weight: 700; }
.sc-pct { font-size: 26rpx; font-weight: 600; margin-top: 4rpx; }
.sc-note {
  clear: both;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #f1f3f7;
  color: #5b6b82;
  font-size: 24rpx;
}

/* ---------- 剔除列表 ---------- */
.exclude-card { padding: 24rpx 28rpx; }
.excluded-item {
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f1f3f7;
}
.excluded-item:last-child { border-bottom: none; }
.ex-top { display: flex; align-items: baseline; }
.ex-name { font-weight: 600; font-size: 27rpx; }
.ex-code { color: #9aa4b2; font-size: 22rpx; margin-left: 12rpx; }
.ex-reason { color: #8a93a3; font-size: 23rpx; margin-top: 6rpx; }

.date-tag { margin-left: auto; }
