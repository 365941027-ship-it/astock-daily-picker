<!-- 市场概览 -->
<view class="hero" wx:if="{{market.total}}">
  <view class="hero-top">
    <view class="hero-title">{{heroTitle}}</view>
    <view class="hero-sub">{{heroSub}}</view>
  </view>
  <view class="hero-indices" wx:if="{{indices.length}}">
    <view wx:for="{{indices}}" wx:key="name" class="hero-index">
      <text class="hi-name">{{item.name}}</text>
      <text class="hi-close num">{{item.close}}</text>
      <text class="hi-pct {{item.pct_chg > 0 ? 'up' : item.pct_chg < 0 ? 'down' : ''}}">{{item.pct_text}}</text>
    </view>
  </view>
  <view class="hero-stats">
    <view class="hs-item"><text class="hs-v up">{{market.up}}</text><text class="hs-k">上涨</text></view>
    <view class="hs-item"><text class="hs-v down">{{market.down}}</text><text class="hs-k">下跌</text></view>
    <view class="hs-item"><text class="hs-v">{{market.flat}}</text><text class="hs-k">平盘</text></view>
    <view class="hs-item"><text class="hs-v up">{{market.limit_up}}</text><text class="hs-k">涨停</text></view>
  </view>
</view>

<!-- 运行参数 -->
<view class="card">
  <view class="card-title">运行参数</view>
  <view class="form-row">
    <text class="label">数据日期</text>
    <picker mode="date" value="{{date}}" bindchange="onDateChange">
      <view class="picker-value">
        <text>{{date || "请选择日期"}}</text>
        <text class="arrow">›</text>
      </view>
    </picker>
  </view>
  <view class="form-row">
    <text class="label">优先数量</text>
    <input type="number" value="{{top}}" bindinput="onTopInput" class="input" maxlength="2" />
  </view>
  <view class="form-row">
    <text class="label">代理（可选）</text>
    <input value="{{proxy}}" bindinput="onProxyInput" class="input" placeholder="socks5h://127.0.0.1:7897" placeholder-class="ph" />
  </view>
  <view class="actions">
    <button class="btn-primary" bindtap="startRun" disabled="{{running}}">
      {{running ? "运行中…" : "开始选股"}}
    </button>
  </view>
  <view class="quick-links">
    <view class="ql-item" bindtap="goSectors">板块热度</view>
    <view class="ql-item" bindtap="subscribeDaily">订阅每日推送</view>
  </view>
</view>

<!-- 运行日志 -->
<view class="card log-card" wx:if="{{logs.length}}">
  <view class="card-title">运行日志</view>
  <scroll-view scroll-y class="log-box" scroll-into-view="logBottom">
    <view wx:for="{{logs}}" wx:key="index" class="log-line">{{item.t}}　{{item.m}}</view>
    <view id="logBottom"></view>
  </scroll-view>
</view>

<!-- 优先观察 -->
<view class="section-head" wx:if="{{result}}">
  <text>优先观察</text>
  <text class="count-badge">{{result.priority.length}}</text>
  <text class="sub date-tag">{{result.data_date}}</text>
</view>
<view class="stock-card" wx:for="{{result.priority}}" wx:key="code"
      bindtap="openDetail" data-code="{{item.code}}" data-date="{{result.data_date}}" data-name="{{item.name}}">
  <view class="sc-left">
    <view class="sc-name">{{item.name}}
      <text class="sc-code">{{item.code}}</text>
    </view>
    <view class="sc-tags">
      <text class="tag tag-blue">{{item.structure}}</text>
      <text class="tag tag-gray">评分 {{item.score}}</text>
    </view>
  </view>
  <view class="sc-right">
    <view class="sc-price num">{{item.close}}</view>
    <view class="sc-pct {{item.pct_chg > 0 ? 'up' : 'down'}}">{{item.pct_text}}</view>
  </view>
  <view class="sc-note">{{item.note}}</view>
</view>
<view class="empty" wx:if="{{result && !result.priority.length}}">本轮没有个股进入优先观察。</view>

<!-- 强势但不宜追高 -->
<view class="section-head" wx:if="{{result}}">
  <text>强势但不宜追高</text>
  <text class="count-badge warn">{{result.strong.length}}</text>
</view>
<view class="stock-card strong" wx:for="{{result.strong}}" wx:key="code"
      bindtap="openDetail" data-code="{{item.code}}" data-date="{{result.data_date}}" data-name="{{item.name}}">
  <view class="sc-left">
    <view class="sc-name">{{item.name}}
      <text class="sc-code">{{item.code}}</text>
    </view>
    <view class="sc-tags">
      <text class="tag tag-orange">等回踩</text>
    </view>
  </view>
  <view class="sc-right">
    <view class="sc-price num">{{item.close}}</view>
    <view class="sc-pct {{item.pct_chg > 0 ? 'up' : 'down'}}">{{item.pct_text}}</view>
  </view>
  <view class="sc-note">{{item.note}}</view>
</view>
<view class="empty" wx:if="{{result && !result.strong.length}}">本轮没有“强势但不宜追高”的标的。</view>

<!-- 剔除或降级观察 -->
<view class="section-head" wx:if="{{result}}">
  <text>剔除或降级观察</text>
  <text class="count-badge">{{result.excluded.length}}</text>
</view>
<view class="card exclude-card" wx:if="{{result && result.excluded.length}}">
  <view wx:for="{{result.excluded}}" wx:key="code" class="excluded-item">
    <view class="ex-top">
      <text class="ex-name">{{item.name}}</text>
      <text class="ex-code">{{item.code}}</text>
    </view>
    <view class="ex-reason">{{item.reasons_text}}</view>
  </view>
</view>

<view class="footer-note">结果仅为技术面筛选的观察池，不构成投资建议，不承诺收益。</view>
