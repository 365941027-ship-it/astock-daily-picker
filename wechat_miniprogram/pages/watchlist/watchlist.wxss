.form-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #f1f3f7;
}
.form-row:last-of-type { border-bottom: none; }
.label { width: 160rpx; color: #6b7684; font-size: 28rpx; }
.input { flex: 1; font-size: 28rpx; }
.ph { color: #b6bfcc; }
.seg { flex: 1; display: flex; gap: 16rpx; }
.seg-item {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 14rpx;
  border: 2rpx solid #e4e8ee;
  color: #6b7684;
  font-size: 26rpx;
}
.seg-item.on {
  background: #e7f1ff;
  border-color: #2563eb;
  color: #2563eb;
  font-weight: 600;
}
.actions { margin-top: 24rpx; }

.watch-card {
  position: relative;
  background: #ffffff;
  border-radius: 24rpx;
  margin: 0 24rpx 16rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(26, 45, 90, 0.06);
}
.wc-left { display: inline-block; max-width: 60%; }
.wc-name { font-size: 30rpx; font-weight: 700; }
.wc-code { color: #9aa4b2; font-size: 22rpx; font-weight: 400; margin-left: 10rpx; }
.wc-alert {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8a93a3;
}
.wc-right { float: right; text-align: right; }
.wc-price { font-size: 34rpx; font-weight: 700; }
.wc-pct { font-size: 26rpx; font-weight: 600; margin-top: 4rpx; }
.wc-del {
  clear: both;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 2rpx solid #f1f3f7;
  color: #e03131;
  font-size: 24rpx;
  text-align: right;
}
.footer-note {
  text-align: center;
  color: #9aa4b2;
  font-size: 22rpx;
  padding: 36rpx 0 60rpx;
}
