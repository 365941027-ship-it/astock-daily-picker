<view class="card">
  <view class="card-title">添加自选</view>
  <view class="form-row">
    <text class="label">代码</text>
    <input class="input" value="{{code}}" bindinput="onCodeInput" placeholder="如 600126" placeholder-class="ph" />
  </view>
  <view class="form-row">
    <text class="label">名称</text>
    <input class="input" value="{{name}}" bindinput="onNameInput" placeholder="如 杭钢股份" placeholder-class="ph" />
  </view>
  <view class="form-row">
    <text class="label">提醒价</text>
    <input class="input" type="digit" value="{{alertPrice}}" bindinput="onAlertInput" placeholder="可选，如 7.10" placeholder-class="ph" />
  </view>
  <view class="form-row">
    <text class="label">提醒方式</text>
    <view class="seg">
      <view class="seg-item {{alertType === 'below' ? 'on' : ''}}" bindtap="setAlertType" data-type="below">跌破提醒</view>
      <view class="seg-item {{alertType === 'above' ? 'on' : ''}}" bindtap="setAlertType" data-type="above">突破提醒</view>
    </view>
  </view>
  <view class="actions">
    <button class="btn-primary" bindtap="addWatch">加入自选</button>
  </view>
</view>

<view class="section-head" wx:if="{{list.length}}">
  <text>我的自选</text>
  <text class="count-badge">{{list.length}}</text>
</view>
<view class="watch-card" wx:for="{{list}}" wx:key="code"
      bindtap="openDetail" data-code="{{item.code}}" data-date="{{defaultDate}}" data-name="{{item.name}}">
  <view class="wc-left">
    <view class="wc-name">{{item.name}}<text class="wc-code">{{item.code}}</text></view>
    <view class="wc-alert" wx:if="{{item.alert_price}}">
      {{item.alert_type === 'above' ? '突破' : '跌破'}} {{item.alert_price}} 提醒
    </view>
    <view class="wc-alert" wx:else>未设价格提醒</view>
  </view>
  <view class="wc-right">
    <view class="wc-price num">{{item.close || '—'}}</view>
    <view class="wc-pct {{item.pct_chg > 0 ? 'up' : item.pct_chg < 0 ? 'down' : ''}}">{{item.pct_text || '—'}}</view>
  </view>
  <view class="wc-del" catchtap="removeWatch" data-code="{{item.code}}">删除</view>
</view>
<view class="empty" wx:if="{{!list.length}}">还没有自选股，添加一只试试吧。</view>

<view class="footer-note">提醒价在每次刷新页面时与最新行情比对，触发条件满足会在列表中以红色标出。</view>
